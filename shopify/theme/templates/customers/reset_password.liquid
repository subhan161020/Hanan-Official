<section class="page">
  <div class="wrap" style="max-width:460px;padding-block:clamp(50px,7vw,90px) var(--sec)">
    <div class="center" style="margin-bottom:2rem">
      <h1 style="font-size:clamp(1.9rem,4vw,2.6rem)">{{ 'customer.recover.title' | t }}</h1>
    </div>
    {%- form 'reset_customer_password', novalidate: 'novalidate' -%}
      {%- if form.errors -%}<div class="form-errors">{{ form.errors | default_errors }}</div>{%- endif -%}
      <div class="field"><label for="np">New password</label>
        <input id="np" type="password" name="customer[password]" autocomplete="new-password" required></div>
      <div class="field"><label for="nc">Confirm password</label>
        <input id="nc" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
      <button class="btn solid block" type="submit">Set new password</button>
    {%- endform -%}
  </div>
</section>
