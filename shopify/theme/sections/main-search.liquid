{%- paginate search.results by 24 -%}
<section class="page">
  {%- render 'breadcrumbs', trail: 'Search' -%}
  <div class="wrap phead">
    <span class="eyebrow">{{ 'general.search.heading' | t }}</span>
    <h1 style="font-size:clamp(2.2rem,5vw,3.6rem)">{{ 'general.search.heading' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" class="inline-form" style="margin:1.6rem auto 0">
      <input type="search" name="q" value="{{ search.terms | escape }}"
             placeholder="{{ 'general.search.placeholder' | t }}" aria-label="{{ 'general.search.heading' | t }}">
      <button class="btn solid" type="submit">{{ 'general.search.heading' | t }}</button>
    </form>
  </div>
  <div class="wrap" style="padding-bottom:var(--sec)">
    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <div class="grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {%- render 'product-card', product: item -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="center small">{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}
      {%- if paginate.pages > 1 -%}
        <nav class="center" style="margin-top:2.4rem" aria-label="Pagination">
          {%- if paginate.previous -%}<a class="link" href="{{ paginate.previous.url }}">Previous</a>{%- endif -%}
          <span class="small" style="margin-inline:1.2rem">Page {{ paginate.current_page }} of {{ paginate.pages }}</span>
          {%- if paginate.next -%}<a class="link" href="{{ paginate.next.url }}">Next</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>
{%- endpaginate -%}
{% schema %}
{ "name": "Search" }
{% endschema %}
