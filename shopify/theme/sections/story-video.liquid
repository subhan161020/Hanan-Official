{%- comment -%}
  The story film.

  Shopify will not accept .mp4 as a theme asset, so the film lives in
  Content → Files and its CDN link goes in the section setting below.
  Without a link the section renders the text half only, rather than an
  empty frame.
{%- endcomment -%}
<section class="sec">
  <div class="wrap">
    <div class="split split-media">
      <div class="split-txt rv">
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.link_text != blank -%}
          <a class="btn" href="{{ section.settings.link }}" style="margin-top:2rem">{{ section.settings.link_text }}</a>
        {%- endif -%}
      </div>

      {%- if section.settings.video_url != blank -%}
        <figure class="vid rv" id="storyVid">
          <video id="storyPlayer"
                 poster="{{ section.settings.poster | default: 'hanan-story-poster.jpg' | asset_url }}"
                 preload="metadata" playsinline controlslist="nodownload" width="1920" height="1080">
            <source src="{{ section.settings.video_url }}" type="video/mp4">
            Your browser cannot play this video.
          </video>
          <button type="button" class="vid-play" id="storyPlayBtn" aria-label="Play the story behind Hanan">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l11-6.5z"></path></svg>
            <span>{{ section.settings.play_label }}</span>
          </button>

          <div class="vid-ctl" id="storyCtl" hidden>
            <button type="button" class="vc-btn" id="vcBack" aria-label="Rewind 10 seconds" title="Rewind 10 seconds">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11.5 6.5v11L4 12zM20 6.5v11L12.5 12z"></path></svg>
            </button>
            <button type="button" class="vc-btn" id="vcToggle" aria-label="Pause" title="Play/pause">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="vc-i-pause"><path d="M7 5h3.2v14H7zM13.8 5H17v14h-3.2z"></path></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true" class="vc-i-play"><path d="M8 5.5v13l11-6.5z"></path></svg>
            </button>
            <button type="button" class="vc-btn" id="vcFwd" aria-label="Forward 10 seconds" title="Forward 10 seconds">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.5 6.5v11L20 12zM4 6.5v11L11.5 12z"></path></svg>
            </button>
            <input class="vc-seek" id="vcSeek" type="range" min="0" max="100" step="0.01" value="0" aria-label="Seek through the video">
            <span class="vc-time" id="vcTime">0:00&thinsp;/&thinsp;0:00</span>
            <button type="button" class="vc-btn" id="vcMute" aria-label="Mute" title="Mute">
              <svg viewBox="0 0 24 24" aria-hidden="true" class="vc-i-on"><path d="M4 9.5h3.5L12 5.5v13L7.5 14.5H4z"></path><path d="M15.5 9a4 4 0 0 1 0 6" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg>
              <svg viewBox="0 0 24 24" aria-hidden="true" class="vc-i-off"><path d="M4 9.5h3.5L12 5.5v13L7.5 14.5H4z"></path><path d="M15.5 9.5l5 5m0-5l-5 5" fill="none" stroke="currentColor" stroke-width="1.6"></path></svg>
            </button>
            <button type="button" class="vc-btn" id="vcFull" aria-label="Full screen" title="Full screen">
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path></svg>
            </button>
          </div>
        </figure>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Story video",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The story behind Hanan" },
    { "type": "text", "id": "link_text", "label": "Button", "default": "Read the full story" },
    { "type": "url", "id": "link", "label": "Button link" },
    {
      "type": "url", "id": "video_url", "label": "Film (MP4)",
      "info": "Upload hanan-story.mp4 under Content → Files, then paste its link here. Shopify does not allow .mp4 in theme assets."
    },
    { "type": "image_picker", "id": "poster", "label": "Poster image", "info": "Falls back to the poster bundled with the theme." },
    { "type": "text", "id": "play_label", "label": "Play button label", "default": "Watch our story" }
  ],
  "presets": [{ "name": "Story video" }]
}
{% endschema %}
