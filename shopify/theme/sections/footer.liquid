<footer class="ftr">
  <div class="wrap">
    <div class="ftr-grid">
      <div>
        <img class="ftr-logo" src="{{ 'hanan-wordmark.webp' | asset_url }}" alt="HANAN" width="559" height="253" loading="lazy">
        <p style="font-size:.88rem;max-width:34ch">{{ section.settings.blurb }}</p>
        <div class="socials">{%- render 'social-links' -%}</div>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu' -%}
          <div {{ block.shopify_attributes }}>
            <h4>{{ block.settings.heading }}</h4>
            <ul>
              {%- for link in linklists[block.settings.menu].links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <div>
        <h4>{{ 'general.newsletter.heading' | t }}</h4>
        <p style="font-size:.88rem">{{ section.settings.newsletter_body }}</p>
        {%- form 'customer', id: 'newsForm', class: 'inline-form', novalidate: 'novalidate' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="email" name="contact[email]"
                 placeholder="{{ 'general.newsletter.label' | t }}"
                 aria-label="{{ 'general.newsletter.label' | t }}" required
                 value="{{ form.email }}"
                 style="border-color:rgba(201,160,99,.45);color:var(--brand-ivory)">
          <button class="btn light" type="submit" style="padding-inline:1.3rem">{{ 'general.newsletter.button' | t }}</button>
          <p class="form-note" id="newsMsg" style="color:var(--gold-lt);margin-top:.8rem;min-height:1.2em">
            {%- if form.posted_successfully? -%}{{ 'general.newsletter.success' | t }}{%- endif -%}
            {%- if form.errors -%}{{ form.errors | default_errors }}{%- endif -%}
          </p>
        {%- endform -%}
        <p style="font-size:.72rem;opacity:.6;margin-top:.4rem">One or two emails a month. Unsubscribe any time.</p>
      </div>
    </div>

    <div class="ftr-btm">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
      <div class="pay">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'pay-icon' }}
        {%- else -%}
          <span>Payment methods appear here once a provider is connected</span>
        {%- endfor -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea", "id": "blurb", "label": "About line",
      "default": "Abayas designed for real life, with discreet nursing access seamlessly concealed. Designed in East London."
    },
    {
      "type": "textarea", "id": "newsletter_body", "label": "Newsletter blurb",
      "default": "Restocks, new drops and Eid pieces go to the list before they go to Instagram."
    }
  ],
  "blocks": [
    {
      "type": "menu", "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "menu", "settings": { "heading": "Shop" } },
      { "type": "menu", "settings": { "heading": "Help" } }
    ]
  }
}
{% endschema %}
