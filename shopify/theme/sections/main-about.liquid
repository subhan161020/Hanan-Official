<section class="page">
  {%- assign about_title = page.title | default: 'About' -%}
  {%- render 'breadcrumbs', trail: about_title -%}

  <div class="wrap phead rv">
    <img src="{{ 'hanan-crest.webp' | asset_url }}" alt="" width="428" height="351"
         style="width:150px;height:auto;margin:0 auto 1.6rem" aria-hidden="true">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 style="font-size:clamp(2.2rem,5vw,3.8rem)">{{ section.settings.heading }}</h1>
    <p class="lede" style="max-width:58ch;margin:1.4rem auto 0">
      <span class="ar" style="font-size:1.4em">{{ section.settings.arabic }}</span> {{ section.settings.lede }}
    </p>
  </div>

  <section class="sec" style="padding-top:2rem">
    <div class="wrap" style="max-width:760px">
      <div class="rv">
        {%- comment -%}
          The founder's story lives in the page body in the Shopify admin, so
          it can be edited without touching the theme.
        {%- endcomment -%}
        {{ page.content }}

        {%- if section.settings.signoff != blank -%}
          <div class="rule" style="margin-block:3rem 2.4rem"><i class="dot"></i></div>
          <p class="lede center" style="font-style:italic">{{ section.settings.signoff }}</p>
        {%- endif -%}
        {%- if section.settings.attribution != blank -%}
          <p class="center small" style="margin-top:2rem">{{ section.settings.attribution }}</p>
        {%- endif -%}
      </div>
    </div>
  </section>
</section>

{% schema %}
{
  "name": "About",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A word that had to become a coat" },
    { "type": "text", "id": "arabic", "label": "Arabic word", "default": "حَنان" },
    {
      "type": "textarea", "id": "lede", "label": "Lede",
      "default": "— hanan. Not love, exactly. The Arabic is more specific than that: the softness a mother turns towards her child. It is the sound in a voice, not a feeling in a chest."
    },
    {
      "type": "html", "id": "signoff", "label": "Sign-off",
      "default": "HANAN<br>Modesty, thoughtfully designed for motherhood."
    },
    { "type": "text", "id": "attribution", "label": "Attribution", "default": "— Salihah Imtiaz Patel, founder" }
  ]
}
{% endschema %}
