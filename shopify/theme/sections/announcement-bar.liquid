{%- if section.blocks.size > 0 -%}
<div class="announce" id="announce" aria-roledescription="carousel" aria-label="Announcements">
  <button class="ann-nav prev" id="annPrev" type="button" aria-label="{{ 'general.accessibility.previous_announcement' | t }}">
    <svg viewBox="0 0 8 12"><path d="M6.5 1L1.5 6l5 5"></path></svg>
  </button>
  <div class="ann-view">
    <div class="ann-track" id="annTrack">
      {%- for block in section.blocks -%}
        <div class="ann-slide" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            {{ block.settings.text }}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
  <button class="ann-nav next" id="annNext" type="button" aria-label="{{ 'general.accessibility.next_announcement' | t }}">
    <svg viewBox="0 0 8 12"><path d="M1.5 1l5 5-5 5"></path></svg>
  </button>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free UK delivery over £120" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "announcement", "settings": { "text": "Free UK delivery over £120" } },
      { "type": "announcement", "settings": { "text": "Discover discreet nursing access for your wardrobe" } }
    ]
  }
}
{% endschema %}
