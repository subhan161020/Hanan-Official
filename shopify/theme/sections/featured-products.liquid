{%- comment -%}
  One card per style rather than one per colourway, so the home page shows
  three abayas instead of twelve near-identical rows. Set "One per style" off
  to list every colourway in the chosen collection.
{%- endcomment -%}
<section class="sec" style="padding-top:0">
  <div class="wrap">
    <div class="center rv" style="margin-bottom:2.8rem">
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <div class="grid g4">
      {%- assign source = collections[section.settings.collection] | default: collections.all -%}
      {%- assign seen_groups = '' -%}
      {%- assign shown = 0 -%}
      {%- for product in source.products -%}
        {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
        {%- if section.settings.one_per_style -%}
          {%- assign group = product.metafields.custom.style_group.value | default: product.id -%}
          {%- assign marker = '|' | append: group | append: '|' -%}
          {%- if seen_groups contains marker -%}{%- continue -%}{%- endif -%}
          {%- assign seen_groups = seen_groups | append: marker -%}
        {%- endif -%}
        {%- render 'product-card', product: product -%}
        {%- assign shown = shown | plus: 1 -%}
      {%- else -%}
        <p class="small">{{ 'collections.general.no_products' | t }}</p>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_text != blank -%}
      <div class="center" style="margin-top:3.4rem">
        <a class="btn" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_text }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The abayas" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three styles, twelve colours" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to use every product." },
    { "type": "checkbox", "id": "one_per_style", "label": "One card per style", "default": true },
    { "type": "range", "id": "limit", "label": "Maximum cards", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "text", "id": "cta_text", "label": "Button", "default": "View every colour" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
