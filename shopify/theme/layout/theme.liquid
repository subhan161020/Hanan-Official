<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#F8F5F0">
<link rel="canonical" href="{{ canonical_url }}">
{%- if settings.favicon != blank -%}
  <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
{%- endif -%}

<title>{{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% unless page_title contains shop.name %} | {{ shop.name }}{% endunless %}</title>
{%- if page_description -%}
  <meta name="description" content="{{ page_description | escape }}">
{%- endif -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Jost:wght@200;300;400;500&family=Amiri:wght@400;700&display=swap" rel="stylesheet">

{{ 'theme.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Shopify injects its own scripts, analytics and the cart object here.
  It must stay in <head> — checkout and the theme editor both depend on it.
{%- endcomment -%}
{{ content_for_header }}
</head>

<body class="template-{{ template.name | handle }}">

{%- render 'icon-robe' -%}

<a class="skip" href="#main">Skip to content</a>

{% section 'announcement-bar' %}
{% section 'header' %}

<div class="scrim" id="scrim"></div>

<main id="main" role="main">
  {{ content_for_layout }}
</main>

{% section 'footer' %}

<script>
  window.HANAN = {
    routes: {
      cart_add_url:    "{{ routes.cart_add_url }}",
      cart_change_url: "{{ routes.cart_change_url }}",
      cart_url:        "{{ routes.cart_url }}"
    },
    strings: {
      chooseSize:  {{ 'products.product.choose_size' | t | json }},
      addingToBag: {{ 'products.product.adding' | t | json }},
      soldOut:     {{ 'products.product.sold_out' | t | json }},
      deliveryNote:{{ 'products.product.delivery_note' | t | json }}
    },
    moneyFormat: {{ shop.money_format | json }}
  };
</script>
<script src="{{ 'theme.js' | asset_url }}" defer></script>

</body>
</html>
